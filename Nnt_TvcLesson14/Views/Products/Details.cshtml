@model Nnt_TvcLesson14.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>Details</h1>

<div>
    <h4>Product</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Name</dt>
        <dd class = "col-sm-10">@Model.Name</dd>

        <dt class = "col-sm-2">Price</dt>
        <dd class = "col-sm-10">@Model.Price</dd>

        <dt class = "col-sm-2">Sale Price</dt>
        <dd class = "col-sm-10">@Model.SalePrice</dd>

        <dt class = "col-sm-2">Status</dt>
        <dd class = "col-sm-10">@Model.Status</dd>

        <dt class = "col-sm-2">Category</dt>
        <dd class = "col-sm-10">@Model.Category?.Name</dd>

        <dt class = "col-sm-2">Created</dt>
        <dd class = "col-sm-10">@Model.CreatedDate.ToString("yyyy-MM-dd")</dd>

        <dt class = "col-sm-2">Image</dt>
        <dd class = "col-sm-10">@Model.Image</dd>

        <dt class = "col-sm-2">Description</dt>
        <dd class = "col-sm-10">@Model.Description</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
