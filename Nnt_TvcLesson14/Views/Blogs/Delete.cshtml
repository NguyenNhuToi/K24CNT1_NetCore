@model Nnt_TvcLesson14.Models.Blog

@{
    ViewData["Title"] = "Delete Blog";
}

<h1>Delete Blog</h1>

<h4>Are you sure you want to delete this?</h4>
<div>
    <h4>Blog</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>

        <dt class="col-sm-2">CreatedDate</dt>
        <dd class="col-sm-10">@Model.CreatedDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-2">Image</dt>
        <dd class="col-sm-10">@Model.Image</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
