@model IEnumerable<TvcLesson10EFDbFirst.Models.TvcMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Tvc Members</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>User Name</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.TvcUserName</td>
            <td>@item.TvcFullName</td>
            <td>@item.TvcEmail</td>
            <td>@item.TvcPhone</td>
            <td>@(item.TvcStatus == true ? "Active" : "Inactive")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
