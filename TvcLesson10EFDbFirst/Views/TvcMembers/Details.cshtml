@model TvcLesson10EFDbFirst.Models.TvcMember

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>TvcMember</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">User Name</dt>
        <dd class="col-sm-10">@Model.TvcUserName</dd>

        <dt class="col-sm-2">Full Name</dt>
        <dd class="col-sm-10">@Model.TvcFullName</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.TvcEmail</dd>

        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.TvcPhone</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@(Model.TvcStatus == true ? "Active" : "Inactive")</dd>
    </dl>
</div>

<p>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
</p>
