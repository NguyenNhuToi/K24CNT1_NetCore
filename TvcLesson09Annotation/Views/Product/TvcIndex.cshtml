@model IEnumerable<TvcLesson09Annotation.Models.DataModels.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="TvcCreate" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Image</th>
            <th>Price</th>
            <th>Sale Price</th>
            <th>Description</th>
            <th>Category</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Image))
                    {
                        <img src="~/products/@item.Image" alt="@item.Name" style="max-height:80px;" />
                    }
                </td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.SalePrice.ToString("C")</td>
                <td>@item.Description</td>
                <td>@item.Category?.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="8">No products available.</td>
        </tr>
    }
    </tbody>
</table>
